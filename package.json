{
  "name": "jovani-chess-lab",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@12.2.0+sha512.66c2632a94e796649738b2d7894d710c2cc2e1696893823066687f6b0d8a52e5f2b54eeaeaa32ffdc513ecca1e49ff794a5c2ec3f9515d879f1b3182b291cf35",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.22.2 || ^24.15.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "12.2.0",
      "onFail": "warn"
    }
  },
  "allowScripts": {
    "esbuild": false,
    "esbuild@0.28.1": true,
    "fsevents": false,
    "netlify-cli": false,
    "unix-dgram": false,
    "unrs-resolver": false
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0",
    "npm": ">=12 <13"
  },
  "scripts": {
    "install:ci": "corepack npm ci",
    "dev": "vite",
    "dev:netlify": "netlify dev",
    "build": "vite build && corepack npm run validate:artifact",
    "start": "netlify serve --offline --context production",
    "deploy:netlify": "netlify deploy --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:artifact": "node --test tests/netlify-artifact.test.mjs",
    "test-all": "corepack npm run format:check && corepack npm run lint && corepack npm run baseline:check && corepack npm run toolchain:check && corepack npm run typecheck && corepack npm run typecheck:compat && corepack npm run test && corepack npm run audit:production && corepack npm run audit:dependencies && corepack npm run security:transitive-guards && corepack npm run build && corepack npm run test:artifact",
    "baseline:check": "corepack npm run generate:favicon:check && node scripts/baseline-contract-check.mjs",
    "generate:favicon": "node scripts/generate-favicon.mjs",
    "generate:favicon:check": "node scripts/generate-favicon.mjs --check",
    "toolchain:check": "node scripts/typescript-toolchain-check.mjs",
    "security:transitive-guards": "node scripts/verify-development-only-dependencies.mjs",
    "validate:artifact": "node scripts/validate-artifact.mjs",
    "audit:production": "corepack npm audit --omit=dev --audit-level=high",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "audit:raw": "corepack npm audit --audit-level=high",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "typecheck:compat": "node node_modules/typescript/bin/tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@xstate/react": "6.1.0",
    "chess.js": "1.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.55.0",
    "motion": "12.43.0",
    "next": "16.3.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "tailwind-merge": "3.7.0",
    "xstate": "5.33.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@opentelemetry/api": "1.9.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.36",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-plugin-unicorn": "65.0.1",
    "jsdom": "30.1.2",
    "netlify-cli": "27.12.0",
    "nitro": "3.0.260610-beta",
    "prettier": "3.9.9",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vinext": "1.1.0",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  },
  "overrides": {
    "sharp": "0.35.5"
  },
  "type": "module",
  "displayName": "Chess Lab by Measured Studios"
}
