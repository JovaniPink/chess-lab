{
  "name": "jovani-chess-lab",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "install:ci": "npm ci",
    "dev": "vite",
    "dev:netlify": "netlify dev",
    "build": "vite build && npm run validate:artifact",
    "start": "netlify serve --offline --context production",
    "deploy:netlify": "netlify deploy --build",
    "deploy:netlify:prod": "netlify deploy --build --prod",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:artifact": "node --test tests/netlify-artifact.test.mjs",
    "test-all": "npm run lint && npm run typecheck && npm run test && npm run audit:production && npm run build && npm run test:artifact",
    "validate:artifact": "node scripts/validate-artifact.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@xstate/react": "^6.1.0",
    "chess.js": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.30.0",
    "motion": "^12.43.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "tailwind-merge": "^3.6.0",
    "xstate": "^5.32.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-unicorn": "^65.0.1",
    "jsdom": "^29.1.1",
    "netlify-cli": "^27.1.1",
    "nitro": "^3.0.260610-beta",
    "prettier": "^3.9.6",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.1",
    "vitest": "^4.1.10"
  },
  "type": "module",
  "displayName": "Jovani Chess Lab"
}
