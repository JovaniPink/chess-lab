{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "group:allNonMajor", "helpers:disableTypesNodeMajor"],
  "packageRules": [
    {
      "description": "Require compatibility review for framework, hosting, and toolchain majors",
      "matchPackageNames": [
        "eslint",
        "eslint-plugin-unicorn",
        "netlify-cli",
        "nitro",
        "vinext",
        "vite",
        "vitest"
      ],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Keep the programmatic TypeScript API on the 6.x compatibility line",
      "matchManagers": ["npm"],
      "matchDepNames": ["typescript"],
      "allowedVersions": "<7"
    },
    {
      "description": "Keep the aliased native TypeScript CLI on the 7.x line",
      "matchManagers": ["npm"],
      "matchDepNames": ["@typescript/native"],
      "allowedVersions": ">=7 <8"
    }
  ]
}
